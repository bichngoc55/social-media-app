generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum HARMFULTYPES {
  VIOLENCE
  HATE_SPEECH
  NUDITY
  SPAM
  HARASSMENT
  OTHER
}

model User {
  id                          String                       @id
  username                    String                       @unique
  displayName                 String
  email                       String?                      @unique
  passwordHash                String?
  googleId                    String?                      @unique
  avatarUrl                   String?
  bio                         String?
  interests                   String[]                     @default([])
  provinceCode                String? // Province/State ID from location data
  districtCode                String? // District/City ID from location data
  countryCode                 String? // Country ID from location data
  createdAt                   DateTime                     @default(now())
  emailVerified               Boolean                      @default(false)
  role                        UserRole                     @default(USER)
  bookmarks                   Bookmark[]
  comments                    Comment[]
  deviceSessions              DeviceSession[]
  emailVerifications          EmailVerification[]
  following                   Follow[]                     @relation("Following")
  followers                   Follow[]                     @relation("Followers")
  likes                       Like[]
  mentionsIssued              Mention[]                    @relation("MentionedBy")
  mentions                    Mention[]                    @relation("Mentioned")
  issuedNotifications         Notification[]               @relation("Issuer")
  receivedNotifications       Notification[]               @relation("Recipient")
  post_tags                   post_tags[]
  posts                       Post[]
  reportsReceived             Report[]                     @relation("Reported")
  reportsIssued               Report[]                     @relation("Reporter")
  sessions                    Session[]
  twoFactorAuths              TwoFactorAuth[]
  blockedByUsers              UserBlock[]                  @relation("Blocked")
  blockedUsers                UserBlock[]                  @relation("Blocker")
  topicEmbeddings             Unsupported("vector(768)")[]
  tasteEmbedding              Unsupported("vector(768)")?
  // AI Recommendations - Cached metrics for performance
  aiMetrics                   UserAIMetrics?
  aiRecommendations           UserRecommendation[]         @relation("RecommendedUser")
  recommendationsFor          UserRecommendation[]         @relation("RecommendedTo")
  // emotion
  generalEmotion              EMOTION?
  emotionScore                Float?
  // dislike
  dislikedPostTopicsEmbedding Unsupported("vector(768)")[] // Array of embeddings for disliked post topics
  blockedPosts                PostBlock[]
  dislikedTopics              String[]                     @default([])

  //  report counts including AI and users
  totalViolateCounts Int @default(0)

  @@map("users")
}

model PostBlock {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("post_blocks")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

enum EMOTION {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

model Post {
  id                    String                       @id @default(cuid())
  content               String
  userId                String
  createdAt             DateTime                     @default(now())
  privacy               PostPrivacy                  @default(PUBLIC)
  mediaLayout           MediaLayout?
  hashtags              String[]                     @default([])
  bookmarks             Bookmark[]
  comments              Comment[]
  likes                 Like[]
  mentions              Mention[]
  linkedNotifications   Notification[]
  attachments           Media[]
  post_tags             post_tags[]
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports               Report[]
  embedding             Unsupported("vector(1408)")? // Multimodal embedding (text+image+video)
  topicEmbeddings       Unsupported("vector(768)")[] // Array of embeddings for each topic
  emotions              EMOTION?
  emotionScore          Float?
  harmful               Boolean                      @default(false)
  harmfulTypes          String[]                     @default([])
  primaryEmotion        String? // e.g. "joy", "sadness", "anger", "gratitude", "loneliness"
  topics                String[]                     @default([]) // e.g. ["beach vacation", "new job", "breakup"]
  wisdomOrAdviceMessage String?
  postBlocks            PostBlock[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([privacy, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  commentId String?
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  post      Post?     @relation(fields: [postId], references: [id])
  comment   Comment?  @relation(fields: [commentId], references: [id])

  @@map("post_media")
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  userId      String
  postId      String
  createdAt   DateTime  @default(now())
  parentId    String?
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentions    Mention[]
  attachments Media[]

  @@index([postId, createdAt(sort: Desc)])
  @@index([parentId])
  @@map("comments")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model DeviceSession {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  deviceName String
  userAgent  String
  ipAddress  String?
  isTrusted  Boolean  @default(false)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("device_sessions")
}

model TwoFactorAuth {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otp       String
  deviceId  String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auths")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  postId     String?
  type       ReportType
  reason     String
  status     ReportStatus @default(PENDING)
  adminNotes String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  reported   User         @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model post_tags {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  status    TagStatus @default(PENDING)
  createdAt DateTime  @default(now())
  posts     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  users     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_tags")
}

model Mention {
  id              String   @id @default(cuid())
  userId          String
  postId          String?
  commentId       String?
  mentionedBy     String
  createdAt       DateTime @default(now())
  comment         Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedByUser User     @relation("MentionedBy", fields: [mentionedBy], references: [id], onDelete: Cascade)
  post            Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User     @relation("Mentioned", fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentions")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PostPrivacy {
  DRAFT
  FOLLOWERS
  PUBLIC
}

enum MediaLayout {
  GRID
  CAROUSEL
  COLUMNS
  FRAME
}

enum NotificationType {
  LIKE
  FOLLOW
  COMMENT
  MESSAGE
  MENTION
  TAG
  TAG_REQUEST
  REPLY
  // Report related
  APPEAL_RESPONSE
  RESOLVED_REPORT
  VIOLATE_COUNTS_RESPONSE
}

enum ReportType {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  NUDITY
  COPYRIGHT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum TagStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

// AI Recommendations - Cached metrics for performance
model UserAIMetrics {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Engagement metrics (cached)
  totalPosts     Int @default(0)
  totalLikes     Int @default(0)
  totalComments  Int @default(0)
  totalFollowers Int @default(0)
  totalFollowing Int @default(0)

  // Activity metrics
  postsLast30Days   Int       @default(0)
  postsLast7Days    Int       @default(0)
  isActiveLast7Days Boolean   @default(false)
  lastPostDate      DateTime?

  // Hashtag preferences (top 10 hashtags user uses)
  topHashtags   String[] @default([])
  hashtagCounts Json? // Map of hashtag -> count

  // Content quality score (0-100)
  engagementRate     Float @default(0)
  avgLikesPerPost    Float @default(0)
  avgCommentsPerPost Float @default(0)

  // Last updated timestamp
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([updatedAt])
  @@map("user_ai_metrics")
}

// AI Recommendations - Store recommendations for users
model UserRecommendation {
  id                String   @id @default(cuid())
  recommendedToId   String // User who will see this recommendation
  recommendedUserId String // User being recommended
  score             Float // AI recommendation score (0-100)
  reason            String? // Why this user is recommended
  metadata          Json? // Additional metadata (hashtags, mutual connections, etc.)
  createdAt         DateTime @default(now())
  expiresAt         DateTime // When this recommendation expires

  recommendedTo   User @relation("RecommendedTo", fields: [recommendedToId], references: [id], onDelete: Cascade)
  recommendedUser User @relation("RecommendedUser", fields: [recommendedUserId], references: [id], onDelete: Cascade)

  @@unique([recommendedToId, recommendedUserId])
  @@index([recommendedToId, score(sort: Desc)])
  @@index([recommendedToId, expiresAt])
  @@index([expiresAt])
  @@map("user_recommendations")
}
