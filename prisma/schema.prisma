generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id
  username              String              @unique
  displayName           String
  email                 String?             @unique
  passwordHash          String?
  googleId              String?             @unique
  avatarUrl             String?
  bio                   String?
  createdAt             DateTime            @default(now())
  emailVerified         Boolean             @default(false)
  role                  UserRole            @default(USER)
  bookmarks             Bookmark[]
  comments              Comment[]
  following             Follow[]            @relation("Following")
  followers             Follow[]            @relation("Followers")
  likes                 Like[]
  issuedNotifications   Notification[]      @relation("Issuer")
  receivedNotifications Notification[]      @relation("Recipient")
  posts                 Post[]
  sessions              Session[]
  emailVerifications    EmailVerification[]
  deviceSessions        DeviceSession[]
  post_tags             post_tags[]
  reportsReceived       Report[]            @relation("Reported")
  reportsIssued         Report[]            @relation("Reporter")
  twoFactorAuths        TwoFactorAuth[]
  blockedByUsers        UserBlock[]         @relation("Blocked")
  blockedUsers          UserBlock[]         @relation("Blocker")

  mentions       Mention[] @relation("Mentioned")
  mentionsIssued Mention[] @relation("MentionedBy")

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id                  String         @id @default(cuid())
  content             String
  userId              String
  createdAt           DateTime       @default(now())
  privacy             PostPrivacy    @default(PUBLIC)
  bookmarks           Bookmark[]
  comments            Comment[]
  likes               Like[]
  linkedNotifications Notification[]
  attachments         Media[]
  post_tags           post_tags[]
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports             Report[]
  mentions            Mention[]

  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  commentId String?
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  post      Post?     @relation(fields: [postId], references: [id])
  comment   Comment?  @relation(fields: [commentId], references: [id])

  @@map("post_media")
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  userId      String
  postId      String
  parentId    String? // For replies
  createdAt   DateTime  @default(now())
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")
  mentions    Mention[]
  attachments Media[]

  @@map("comments")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model DeviceSession {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  deviceName String
  userAgent  String
  ipAddress  String?
  isTrusted  Boolean  @default(false)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("device_sessions")
}

model TwoFactorAuth {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otp       String
  deviceId  String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auths")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  postId     String?
  type       ReportType
  reason     String
  status     ReportStatus @default(PENDING)
  adminNotes String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  reported   User         @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model post_tags {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  status    TagStatus @default(PENDING)
  createdAt DateTime  @default(now())
  posts     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  users     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_tags")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PostPrivacy {
  DRAFT
  FOLLOWERS
  PUBLIC
}

enum NotificationType {
  LIKE
  FOLLOW
  COMMENT
  TAG
  TAG_REQUEST
  MESSAGE
  MENTION
}

model Mention {
  id              String   @id @default(cuid())
  userId          String
  postId          String?
  commentId       String?
  mentionedBy     String
  createdAt       DateTime @default(now())
  user            User     @relation("Mentioned", fields: [userId], references: [id], onDelete: Cascade)
  mentionedByUser User     @relation("MentionedBy", fields: [mentionedBy], references: [id], onDelete: Cascade)
  post            Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment         Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("mentions")
}

enum ReportType {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  NUDITY
  COPYRIGHT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum TagStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}
