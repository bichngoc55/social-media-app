generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                          String                   @id
  username                    String                   @unique
  displayName                 String
  email                       String?                  @unique
  passwordHash                String?
  googleId                    String?                  @unique
  avatarUrl                   String?
  bio                         String?
  createdAt                   DateTime                 @default(now())
  emailVerified               Boolean                  @default(false)
  role                        UserRole                 @default(USER)
  provinceCode                String?
  districtCode                String?
  countryCode                 String?
  emotionScore                Float?
  generalEmotion              EMOTION?
  interests                   String[]                 @default([])
  tasteEmbedding              Unsupported("vector")?
  topicEmbeddings             Unsupported("_vector")[]
  dislikedPostTopicsEmbedding Unsupported("_vector")[]
  dislikedTopics              String[]                 @default([])
  totalViolateCounts          Int                      @default(0)
  warningCount                Int                      @default(0)
  bannedUntil                 DateTime?
  lastWarningAt               DateTime?
  status                      Boolean                  @default(true)
  appealUserReports           AppealUserReport[]
  warnings                    UserWarning[]
  bookmarks                   Bookmark[]
  comments                    Comment[]
  deviceSessions              DeviceSession[]
  emailVerifications          EmailVerification[]
  following                   Follow[]                 @relation("Following")
  followers                   Follow[]                 @relation("Followers")
  likes                       Like[]
  mentionsIssued              Mention[]                @relation("MentionedBy")
  mentions                    Mention[]                @relation("Mentioned")
  assignedModerationCases     ModerationCase[]         @relation("AssignedModerator")
  moderationDecisions         ModerationCase[]         @relation("DecisionModerator")
  moderatedContent            ModerationCase[]         @relation("ModeratedUser")
  issuedNotifications         Notification[]           @relation("Issuer")
  receivedNotifications       Notification[]           @relation("Recipient")
  blockedPosts                PostBlock[]
  post_tags                   post_tags[]
  posts                       Post[]
  reportsReceived             Report[]                 @relation("Reported")
  reportsIssued               Report[]                 @relation("Reporter")
  sessions                    Session[]
  twoFactorAuths              TwoFactorAuth[]
  aiMetrics                   UserAIMetrics?
  blockedByUsers              UserBlock[]              @relation("Blocked")
  blockedUsers                UserBlock[]              @relation("Blocker")
  recommendationsFor          UserRecommendation[]     @relation("RecommendedTo")
  aiRecommendations           UserRecommendation[]     @relation("RecommendedUser")
  warningsIssued              UserWarning[]           @relation("WarningIssuer")

  @@map("users")
}

model PostBlock {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("post_blocks")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Post {
  id                    String                   @id @default(cuid())
  content               String
  userId                String
  createdAt             DateTime                 @default(now())
  privacy               PostPrivacy              @default(PUBLIC)
  mediaLayout           MediaLayout?
  hashtags              String[]                 @default([])
  embedding             Unsupported("vector")?
  topicEmbeddings       Unsupported("_vector")[]
  emotions              EMOTION?
  emotionScore          Float?
  harmful               Boolean                  @default(false)
  harmfulTypes          String[]                 @default([])
  primaryEmotion        String?
  topics                String[]                 @default([])
  wisdomOrAdviceMessage String?
  appealUserReports     AppealUserReport[]
  bookmarks             Bookmark[]
  comments              Comment[]
  likes                 Like[]
  mentions              Mention[]
  moderationCases       ModerationCase[]
  linkedNotifications   Notification[]
  postBlocks            PostBlock[]
  attachments           Media[]
  post_tags             post_tags[]
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports               Report[]
  warnings              UserWarning[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([privacy, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([content(ops: raw("gist_trgm_ops"))], map: "posts_content_trgm_idx", type: Gist)
  @@index([embedding])
  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  commentId String?
  comment   Comment?  @relation(fields: [commentId], references: [id])
  post      Post?     @relation(fields: [postId], references: [id])

  @@map("post_media")
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  userId      String
  postId      String
  createdAt   DateTime  @default(now())
  parentId    String?
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentions    Mention[]
  attachments Media[]

  @@index([postId, createdAt(sort: Desc)])
  @@index([parentId])
  @@map("comments")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model DeviceSession {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  deviceName String
  userAgent  String
  ipAddress  String?
  isTrusted  Boolean  @default(false)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("device_sessions")
}

model TwoFactorAuth {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otp       String
  deviceId  String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auths")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  postId     String?
  type       ReportType
  reason     String
  status     ReportStatus @default(PENDING)
  adminNotes String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  reported   User         @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model post_tags {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  status    TagStatus @default(PENDING)
  createdAt DateTime  @default(now())
  posts     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  users     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_tags")
}

model Mention {
  id              String   @id @default(cuid())
  userId          String
  postId          String?
  commentId       String?
  mentionedBy     String
  createdAt       DateTime @default(now())
  comment         Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedByUser User     @relation("MentionedBy", fields: [mentionedBy], references: [id], onDelete: Cascade)
  post            Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User     @relation("Mentioned", fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentions")
}

model UserAIMetrics {
  id                 String    @id @default(cuid())
  userId             String    @unique
  totalPosts         Int       @default(0)
  totalLikes         Int       @default(0)
  totalComments      Int       @default(0)
  totalFollowers     Int       @default(0)
  totalFollowing     Int       @default(0)
  postsLast30Days    Int       @default(0)
  postsLast7Days     Int       @default(0)
  isActiveLast7Days  Boolean   @default(false)
  lastPostDate       DateTime?
  topHashtags        String[]  @default([])
  hashtagCounts      Json?
  engagementRate     Float     @default(0)
  avgLikesPerPost    Float     @default(0)
  avgCommentsPerPost Float     @default(0)
  updatedAt          DateTime  @default(now()) @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
  @@map("user_ai_metrics")
}

model UserRecommendation {
  id                String   @id @default(cuid())
  recommendedToId   String
  recommendedUserId String
  score             Float
  reason            String?
  metadata          Json?
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  recommendedTo     User     @relation("RecommendedTo", fields: [recommendedToId], references: [id], onDelete: Cascade)
  recommendedUser   User     @relation("RecommendedUser", fields: [recommendedUserId], references: [id], onDelete: Cascade)

  @@unique([recommendedToId, recommendedUserId])
  @@index([recommendedToId, score(sort: Desc)])
  @@index([recommendedToId, expiresAt])
  @@index([expiresAt])
  @@map("user_recommendations")
}

model ModerationCase {
  id                  String                @id @default(cuid())
  postId              String?
  userId              String?
  source              ModerationSource      @default(AI)
  policyAreaPredicted ModerationPolicyArea?
  confidence          Float?
  severity            ModerationSeverity    @default(MEDIUM)
  modelVersion        String?
  harmfulTypes        String[]              @default([])
  autoAction          ModerationAutoAction  @default(NONE)
  autoActionAppliedAt DateTime?
  status              ModerationStatus      @default(DETECTED)
  priorityScore       Float                 @default(0.0)
  assignedTo          String?
  slaDueAt            DateTime?
  decision            ModerationDecision?
  decisionAt          DateTime?
  decisionBy          String?
  policyArea          ModerationPolicyArea?
  reasonCode          String?
  evidence            Json?
  adminNotes          String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  assignedAdmin       User?                 @relation("AssignedModerator", fields: [assignedTo], references: [id])
  decisionAdmin       User?                 @relation("DecisionModerator", fields: [decisionBy], references: [id])
  post                Post?                 @relation(fields: [postId], references: [id])
  user                User?                 @relation("ModeratedUser", fields: [userId], references: [id])

  @@index([status, priorityScore(sort: Desc)])
  @@index([assignedTo, status])
  @@index([postId])
  @@index([userId])
  @@index([slaDueAt])
  @@index([source, status])
  @@map("moderation_cases")
}

model AppealUserReport {
  id           String       @id @default(cuid())
  userId       String
  postId       String
  appealReason String
  status       AppealStatus @default(PENDING)
  adminNotes   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appeal_user_reports")
}

model UserWarning {
  id          String   @id @default(cuid())
  userId      String
  issuedBy    String
  message     String
  deadline    DateTime?
  postId      String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin       User     @relation("WarningIssuer", fields: [issuedBy], references: [id], onDelete: Cascade)
  post        Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([postId])
  @@map("user_warnings")
}

enum HARMFULTYPES {
  VIOLENCE
  HATE_SPEECH
  NUDITY
  SPAM
  HARASSMENT
  OTHER
}

enum EMOTION {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PostPrivacy {
  DRAFT
  FOLLOWERS
  PUBLIC
}

enum MediaLayout {
  GRID
  CAROUSEL
  COLUMNS
  FRAME
}

enum NotificationType {
  LIKE
  FOLLOW
  COMMENT
  MESSAGE
  MENTION
  TAG
  TAG_REQUEST
  REPLY
  APPEAL_RESPONSE
  RESOLVED_REPORT
  VIOLATE_COUNTS_RESPONSE
  WARNING
  BAN_NOTICE
}

enum ReportType {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  NUDITY
  COPYRIGHT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum TagStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

enum ModerationSource {
  AI
  USER_REPORT
  ADMIN_MANUAL
}

enum ModerationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModerationAutoAction {
  NONE
  BLUR
  REDUCE_DISTRIBUTION
  TEMP_REMOVE
  AUTO_REMOVE
}

enum ModerationStatus {
  DETECTED
  QUEUED
  IN_REVIEW
  CONFIRMED
  RESTORED
  DISMISSED
  ESCALATED
  APPEALED
}

enum ModerationDecision {
  CONFIRM_VIOLATION
  RESTORE
  DISMISS
  ESCALATE
  NEED_MORE_CONTEXT
}

enum ModerationPolicyArea {
  NUDITY
  VIOLENCE
  HATE_SPEECH
  HARASSMENT
  SELF_HARM
  SPAM
  SCAM
  COPYRIGHT
  IMPERSONATION
  OTHER
}

enum AppealStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}
